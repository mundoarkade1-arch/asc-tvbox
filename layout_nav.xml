<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/group_nav"
    android:layout_width="match_parent"
    android:layout_height="60dp"
    android:background="@drawable/bg_nav"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingLeft="20dp"
    android:paddingRight="20dp">

    <ImageView
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:contentDescription="@null"
        android:focusable="false"
        android:src="@drawable/brand_icon" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="8dp"
        android:layout_marginRight="28dp"
        android:text="ASC lite"
        android:textColor="#FF2A3D"
        android:textSize="21sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/nav_home"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_marginLeft="3dp"
        android:layout_marginRight="3dp"
        android:background="@drawable/bg_nav_tab"
        android:clickable="true"
        android:contentDescription="Tela inicial"
        android:drawableLeft="@drawable/ic_nav_home"
        android:drawablePadding="8dp"
        android:focusable="true"
        android:gravity="center_vertical"
        android:nextFocusRight="@+id/nav_live"
        android:paddingLeft="14dp"
        android:paddingRight="16dp"
        android:singleLine="true"
        android:text="Início"
        android:textColor="@color/nav_text"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/nav_live"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_marginLeft="3dp"
        android:layout_marginRight="3dp"
        android:background="@drawable/bg_nav_tab"
        android:clickable="true"
        android:contentDescription="Canais"
        android:drawableLeft="@drawable/ic_nav_live"
        android:drawablePadding="8dp"
        android:focusable="true"
        android:gravity="center_vertical"
        android:nextFocusLeft="@+id/nav_home"
        android:nextFocusRight="@+id/nav_movie"
        android:paddingLeft="14dp"
        android:paddingRight="16dp"
        android:singleLine="true"
        android:text="Canais"
        android:textColor="@color/nav_text"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/nav_movie"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_marginLeft="3dp"
        android:layout_marginRight="3dp"
        android:background="@drawable/bg_nav_tab"
        android:clickable="true"
        android:contentDescription="Filmes"
        android:drawableLeft="@drawable/ic_nav_movie"
        android:drawablePadding="8dp"
        android:focusable="true"
        android:gravity="center_vertical"
        android:nextFocusLeft="@+id/nav_live"
        android:nextFocusRight="@+id/nav_series"
        android:paddingLeft="14dp"
        android:paddingRight="16dp"
        android:singleLine="true"
        android:text="Filmes"
        android:textColor="@color/nav_text"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/nav_series"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_marginLeft="3dp"
        android:layout_marginRight="3dp"
        android:background="@drawable/bg_nav_tab"
        android:clickable="true"
        android:contentDescription="Séries"
        android:drawableLeft="@drawable/ic_nav_series"
        android:drawablePadding="8dp"
        android:focusable="true"
        android:gravity="center_vertical"
        android:nextFocusLeft="@+id/nav_movie"
        android:nextFocusRight="@+id/nav_settings"
        android:paddingLeft="14dp"
        android:paddingRight="16dp"
        android:singleLine="true"
        android:text="Séries"
        android:textColor="@color/nav_text"
        android:textSize="15sp"
        android:textStyle="bold" />

    <View
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_weight="1"
        android:focusable="false" />

    <TextView
        android:id="@+id/nav_settings"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_marginLeft="3dp"
        android:layout_marginRight="3dp"
        android:background="@drawable/bg_nav_tab"
        android:clickable="true"
        android:contentDescription="Ajustes"
        android:drawableLeft="@drawable/ic_nav_settings"
        android:drawablePadding="8dp"
        android:focusable="true"
        android:gravity="center_vertical"
        android:nextFocusLeft="@+id/nav_series"
        android:nextFocusRight="@+id/nav_refresh"
        android:paddingLeft="14dp"
        android:paddingRight="16dp"
        android:singleLine="true"
        android:text="Ajustes"
        android:textColor="@color/nav_text"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/nav_refresh"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_marginLeft="3dp"
        android:layout_marginRight="3dp"
        android:background="@drawable/bg_nav_tab"
        android:clickable="true"
        android:contentDescription="Atualizar lista"
        android:drawableLeft="@drawable/ic_nav_refresh"
        android:drawablePadding="8dp"
        android:focusable="true"
        android:gravity="center_vertical"
        android:nextFocusLeft="@+id/nav_settings"
        android:paddingLeft="14dp"
        android:paddingRight="16dp"
        android:singleLine="true"
        android:text="Atualizar"
        android:textColor="@color/nav_text"
        android:textSize="15sp"
        android:textStyle="bold" />
</LinearLayout>
