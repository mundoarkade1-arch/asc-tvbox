<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A1A33">

    <androidx.media3.ui.PlayerView
        android:id="@+id/player_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:show_buffering="never"
        app:show_timeout="3000"
        app:show_rewind_button="false"
        app:show_fastforward_button="false"
        app:show_previous_button="false"
        app:show_next_button="false"
        app:played_color="#1F6FEB"
        app:scrubber_color="#5AA2FF"
        app:buffered_color="#66B8C0CC"
        app:unplayed_color="#33FFFFFF"
        app:use_controller="true" />

    <TextView
        android:id="@+id/status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="#990A1A33"
        android:padding="12dp"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:visibility="gone" />

    <ProgressBar
        android:id="@+id/loading_spinner"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_gravity="center"
        android:focusable="false"
        android:indeterminate="true"
        android:indeterminateDrawable="@drawable/spinner_red"
        android:indeterminateOnly="true"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/group_nowbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_nowbar_scrim"
        android:clickable="false"
        android:focusable="false"
        android:orientation="horizontal"
        android:paddingStart="48dp"
        android:paddingTop="56dp"
        android:paddingEnd="48dp"
        android:paddingBottom="22dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="3"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_nb_channel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#B8C0CC"
                android:shadowColor="#E60A1A33"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="6"
                android:textSize="24sp" />

            <TextView
                android:id="@+id/tv_nb_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#FFFFFF"
                android:shadowColor="#E60A1A33"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="6"
                android:textSize="34sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_nb_start"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#FFFFFF"
                    android:shadowColor="#E60A1A33"
                    android:shadowDx="0"
                    android:shadowDy="1"
                    android:shadowRadius="6"
                    android:textSize="24sp" />

                <ProgressBar
                    android:id="@+id/pb_nowbar"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="0dp"
                    android:layout_height="6dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:layout_weight="1"
                    android:max="100"
                    android:progress="0"
                    android:progressTint="#1F6FEB"
                    android:progressBackgroundTint="#33FFFFFF" />

                <TextView
                    android:id="@+id/tv_nb_end"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#FFFFFF"
                    android:shadowColor="#E60A1A33"
                    android:shadowDx="0"
                    android:shadowDy="1"
                    android:shadowRadius="6"
                    android:textSize="24sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/tv_nb_next"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_marginStart="32dp"
            android:layout_weight="2"
            android:ellipsize="end"
            android:gravity="end"
            android:maxLines="2"
            android:textColor="#B8C0CC"
            android:shadowColor="#E60A1A33"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="6"
            android:textSize="26sp" />
    </LinearLayout>

</FrameLayout>
