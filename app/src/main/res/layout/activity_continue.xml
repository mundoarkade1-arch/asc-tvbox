<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0C0A0B"
    android:orientation="vertical"
    android:paddingStart="48dp"
    android:paddingTop="16dp"
    android:paddingEnd="48dp"
    android:paddingBottom="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Continue assistindo"
        android:textColor="#FF2A3D"
        android:textSize="26sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_continue_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Carregando..."
        android:textColor="#A39A9D"
        android:textSize="18sp" />

    <ListView
        android:id="@+id/lv_continue"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:divider="@android:color/transparent"
        android:dividerHeight="6dp"
        android:drawSelectorOnTop="false"
        android:listSelector="@drawable/bg_button" />

</LinearLayout>
