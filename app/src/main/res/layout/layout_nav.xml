<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/group_nav"
    android:layout_width="88dp"
    android:layout_height="match_parent"
    android:background="#151113"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingTop="20dp"
    android:paddingBottom="20dp">

    <ImageButton
        android:id="@+id/nav_home"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bg_button"
        android:contentDescription="Tela inicial"
        android:focusable="true"
        android:scaleType="center"
        android:src="@drawable/ic_nav_home" />

    <ImageButton
        android:id="@+id/nav_live"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bg_button"
        android:contentDescription="Canais"
        android:focusable="true"
        android:scaleType="center"
        android:src="@drawable/ic_nav_live" />

    <ImageButton
        android:id="@+id/nav_movie"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bg_button"
        android:contentDescription="Filmes"
        android:focusable="true"
        android:scaleType="center"
        android:src="@drawable/ic_nav_movie" />

    <ImageButton
        android:id="@+id/nav_series"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bg_button"
        android:contentDescription="Séries"
        android:focusable="true"
        android:scaleType="center"
        android:src="@drawable/ic_nav_series" />

    <ImageButton
        android:id="@+id/nav_settings"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:background="@drawable/bg_button"
        android:contentDescription="Ajustes"
        android:focusable="true"
        android:scaleType="center"
        android:src="@drawable/ic_nav_settings" />

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <ImageButton
        android:id="@+id/nav_refresh"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:background="@drawable/bg_button"
        android:contentDescription="Atualizar lista"
        android:focusable="true"
        android:scaleType="center"
        android:src="@drawable/ic_nav_refresh" />
</LinearLayout>
