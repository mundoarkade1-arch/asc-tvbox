<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient"
    android:orientation="horizontal">

    <LinearLayout
        android:id="@+id/group_nav"
        android:layout_width="72dp"
        android:layout_height="match_parent"
        android:background="@drawable/bg_nav"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingTop="10dp"
        android:paddingBottom="10dp">

        <TextView
            android:id="@+id/nav_home"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginLeft="8dp"
            android:layout_marginTop="4dp"
            android:layout_marginRight="8dp"
            android:layout_marginBottom="4dp"
            android:background="@drawable/bg_nav_home"
            android:clickable="true"
            android:contentDescription="Tela inicial"
            android:drawableTop="@drawable/ic_nav_home"
            android:drawablePadding="1dp"
            android:ellipsize="end"
            android:focusable="true"
            android:gravity="center"
                    android:nextFocusDown="@+id/nav_live"
            android:paddingLeft="2dp"
            android:paddingTop="6dp"
            android:paddingRight="2dp"
            android:paddingBottom="4dp"
            android:singleLine="true"
            android:text="Início"
            android:textColor="@color/nav_text"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/nav_live"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginLeft="8dp"
            android:layout_marginTop="4dp"
            android:layout_marginRight="8dp"
            android:layout_marginBottom="4dp"
            android:background="@drawable/bg_nav_live"
            android:clickable="true"
            android:contentDescription="Canais"
            android:drawableTop="@drawable/ic_nav_live"
            android:drawablePadding="1dp"
            android:ellipsize="end"
            android:focusable="true"
            android:gravity="center"
                    android:nextFocusDown="@+id/nav_movie"
                    android:nextFocusUp="@+id/nav_home"
            android:paddingLeft="2dp"
            android:paddingTop="6dp"
            android:paddingRight="2dp"
            android:paddingBottom="4dp"
            android:singleLine="true"
            android:text="Canais"
            android:textColor="@color/nav_text"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/nav_movie"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginLeft="8dp"
            android:layout_marginTop="4dp"
            android:layout_marginRight="8dp"
            android:layout_marginBottom="4dp"
            android:background="@drawable/bg_nav_movie"
            android:clickable="true"
            android:contentDescription="Filmes"
            android:drawableTop="@drawable/ic_nav_movie"
            android:drawablePadding="1dp"
            android:ellipsize="end"
            android:focusable="true"
            android:gravity="center"
                    android:nextFocusDown="@+id/nav_series"
                    android:nextFocusUp="@+id/nav_live"
            android:paddingLeft="2dp"
            android:paddingTop="6dp"
            android:paddingRight="2dp"
            android:paddingBottom="4dp"
            android:singleLine="true"
            android:text="Filmes"
            android:textColor="@color/nav_text"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/nav_series"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginLeft="8dp"
            android:layout_marginTop="4dp"
            android:layout_marginRight="8dp"
            android:layout_marginBottom="4dp"
            android:background="@drawable/bg_nav_series"
            android:clickable="true"
            android:contentDescription="Séries"
            android:drawableTop="@drawable/ic_nav_series"
            android:drawablePadding="1dp"
            android:ellipsize="end"
            android:focusable="true"
            android:gravity="center"
                    android:nextFocusDown="@+id/nav_settings"
                    android:nextFocusUp="@+id/nav_movie"
            android:paddingLeft="2dp"
            android:paddingTop="6dp"
            android:paddingRight="2dp"
            android:paddingBottom="4dp"
            android:singleLine="true"
            android:text="Séries"
            android:textColor="@color/nav_text"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/nav_settings"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginLeft="8dp"
            android:layout_marginTop="4dp"
            android:layout_marginRight="8dp"
            android:layout_marginBottom="4dp"
            android:background="@drawable/bg_nav_settings"
            android:clickable="true"
            android:contentDescription="Ajustes"
            android:drawableTop="@drawable/ic_nav_settings"
            android:drawablePadding="1dp"
            android:ellipsize="end"
            android:focusable="true"
            android:gravity="center"
                    android:nextFocusDown="@+id/nav_refresh"
                    android:nextFocusUp="@+id/nav_series"
            android:paddingLeft="2dp"
            android:paddingTop="6dp"
            android:paddingRight="2dp"
            android:paddingBottom="4dp"
            android:singleLine="true"
            android:text="Ajustes"
            android:textColor="@color/nav_text"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/nav_refresh"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginLeft="8dp"
            android:layout_marginTop="4dp"
            android:layout_marginRight="8dp"
            android:layout_marginBottom="4dp"
            android:background="@drawable/bg_nav_refresh"
            android:clickable="true"
            android:contentDescription="Atualizar lista"
            android:drawableTop="@drawable/ic_nav_refresh"
            android:drawablePadding="1dp"
            android:ellipsize="end"
            android:focusable="true"
            android:gravity="center"
                    android:nextFocusUp="@+id/nav_settings"
            android:paddingLeft="2dp"
            android:paddingTop="6dp"
            android:paddingRight="2dp"
            android:paddingBottom="4dp"
            android:singleLine="true"
            android:text="Atualizar"
            android:textColor="@color/nav_text"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="6dp"
        android:paddingEnd="24dp"
        android:paddingBottom="6dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:contentDescription="@null"
                android:focusable="false"
                android:src="@drawable/brand_icon" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="ASC lite"
                android:textColor="#FF2A3D"
                android:textSize="24sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ScrollView
            android:id="@+id/scroll_home"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:focusable="false"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:orientation="vertical"
                android:paddingTop="4dp"
                android:paddingBottom="12dp">

                <LinearLayout
                    android:id="@+id/group_update"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/tv_update"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="#4ADE80"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btn_update_now"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:background="@drawable/bg_button"
                        android:minHeight="48dp"
                        android:paddingStart="20dp"
                        android:paddingEnd="20dp"
                        android:text="@string/btn_update_now"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btn_update_later"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:background="@drawable/bg_button"
                        android:minHeight="48dp"
                        android:paddingStart="20dp"
                        android:paddingEnd="20dp"
                        android:text="@string/btn_update_later"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/group_continue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:clipChildren="false"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Continue assistindo"
                        android:textColor="#F7F3F4"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="280dp"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:paddingStart="8dp"
                        android:paddingTop="8dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="8dp"
                        android:scrollbars="none">

                        <LinearLayout
                            android:id="@+id/rail_continue"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:clipChildren="false"
                            android:orientation="horizontal" />
                    </HorizontalScrollView>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:clipChildren="false"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Canais ao vivo"
                        android:textColor="#F7F3F4"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/st_live"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Carregando..."
                        android:textColor="#A99FA3"
                        android:textSize="14sp" />

                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="200dp"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:paddingStart="8dp"
                        android:paddingTop="8dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="8dp"
                        android:scrollbars="none">

                        <LinearLayout
                            android:id="@+id/rail_live"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:clipChildren="false"
                            android:orientation="horizontal" />
                    </HorizontalScrollView>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:clipChildren="false"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Filmes"
                        android:textColor="#F7F3F4"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/st_movie"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Carregando..."
                        android:textColor="#A99FA3"
                        android:textSize="14sp" />

                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="280dp"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:paddingStart="8dp"
                        android:paddingTop="8dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="8dp"
                        android:scrollbars="none">

                        <LinearLayout
                            android:id="@+id/rail_movie"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:clipChildren="false"
                            android:orientation="horizontal" />
                    </HorizontalScrollView>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:clipChildren="false"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Séries"
                        android:textColor="#F7F3F4"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/st_series"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Carregando..."
                        android:textColor="#A99FA3"
                        android:textSize="14sp" />

                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="280dp"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:paddingStart="8dp"
                        android:paddingTop="8dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="8dp"
                        android:scrollbars="none">

                        <LinearLayout
                            android:id="@+id/rail_series"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:clipChildren="false"
                            android:orientation="horizontal" />
                    </HorizontalScrollView>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

    </LinearLayout>
</LinearLayout>
