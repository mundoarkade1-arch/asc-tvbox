<?xml version="1.0" encoding="utf-8"?>
<!-- Botão principal: azul de destaque (#1F6FEB). No foco ganha anel #5AA2FF e brilho suave. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <stroke android:width="6dp" android:color="@color/asc_accent_glow" />
                    <corners android:radius="17dp" />
                </shape>
            </item>
            <item android:left="3dp" android:top="3dp" android:right="3dp" android:bottom="3dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/asc_accent" />
                    <stroke android:width="2dp" android:color="@color/asc_focus" />
                    <corners android:radius="14dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:state_pressed="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <stroke android:width="6dp" android:color="@color/asc_accent_glow" />
                    <corners android:radius="17dp" />
                </shape>
            </item>
            <item android:left="3dp" android:top="3dp" android:right="3dp" android:bottom="3dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/asc_accent" />
                    <stroke android:width="2dp" android:color="@color/asc_focus" />
                    <corners android:radius="14dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/asc_accent" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</selector>
