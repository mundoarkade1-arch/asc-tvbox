<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:top="2dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/asc_glass_shadow" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item android:bottom="2dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/asc_glass_mid" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item android:bottom="2dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="@color/asc_glass_sheen_end"
                android:startColor="@color/asc_glass_sheen" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item android:bottom="2dp">
        <shape android:shape="rectangle">
            <stroke android:width="1dp" android:color="@color/asc_glass_border" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</layer-list>
