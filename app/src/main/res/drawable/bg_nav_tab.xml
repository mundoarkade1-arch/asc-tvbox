<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <stroke android:width="6dp" android:color="#59FF2A3D" />
                    <corners android:radius="17dp" />
                </shape>
            </item>
            <item android:left="3dp" android:top="3dp" android:right="3dp" android:bottom="3dp">
                <shape android:shape="rectangle">
                    <gradient android:angle="315" android:startColor="#FF3B4E" android:endColor="#D3091B" />
                    <stroke android:width="3dp" android:color="#FFFFFF" />
                    <corners android:radius="14dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:state_pressed="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <stroke android:width="6dp" android:color="#59FF2A3D" />
                    <corners android:radius="17dp" />
                </shape>
            </item>
            <item android:left="3dp" android:top="3dp" android:right="3dp" android:bottom="3dp">
                <shape android:shape="rectangle">
                    <solid android:color="#D3091B" />
                    <stroke android:width="3dp" android:color="#FFFFFF" />
                    <corners android:radius="14dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <gradient android:angle="315" android:startColor="#FF3B4E" android:endColor="#D3091B" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#12FFFFFF" />
            <stroke android:width="1dp" android:color="#17FFFFFF" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</selector>
