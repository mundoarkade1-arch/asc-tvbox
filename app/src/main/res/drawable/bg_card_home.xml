<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <layer-list>
            <item
                android:left="-4dp"
                android:top="-4dp"
                android:right="-4dp"
                android:bottom="-4dp">
                <shape android:shape="rectangle">
                    <stroke android:width="2dp" android:color="@color/asc_accent_glow" />
                    <corners android:radius="16dp" />
                </shape>
            </item>
            <item
                android:left="-2dp"
                android:top="-2dp"
                android:right="-2dp"
                android:bottom="-2dp">
                <shape android:shape="rectangle">
                    <stroke android:width="2dp" android:color="@color/asc_focus" />
                    <corners android:radius="14dp" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/asc_glass_focus" />
                    <corners android:radius="12dp" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="270"
                        android:endColor="@color/asc_glass_sheen_end"
                        android:startColor="@color/asc_glass_sheen" />
                    <corners android:radius="12dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:drawable="@drawable/glass_light" />
</selector>
