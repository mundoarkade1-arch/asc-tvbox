<?xml version="1.0" encoding="utf-8"?>
<!-- Foco dos cards em grade: anéis que saem 4dp para fora (a grade não corta), vidro translúcido por dentro -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:left="-4dp"
        android:top="-4dp"
        android:right="-4dp"
        android:bottom="-4dp">
        <shape android:shape="rectangle">
            <stroke android:width="1dp" android:color="@color/asc_accent_glow" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <item
        android:left="-3dp"
        android:top="-3dp"
        android:right="-3dp"
        android:bottom="-3dp">
        <shape android:shape="rectangle">
            <stroke android:width="3dp" android:color="@color/asc_accent" />
            <corners android:radius="19dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/asc_glass_focus" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="@color/asc_glass_sheen_end"
                android:startColor="@color/asc_glass_sheen" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</layer-list>
