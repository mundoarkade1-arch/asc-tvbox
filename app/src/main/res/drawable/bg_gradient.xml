<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#09070A" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:type="radial" android:centerX="0.0" android:centerY="0.0"
                android:gradientRadius="75%p" android:startColor="#33050B" android:endColor="#0033050B" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:type="radial" android:centerX="1.0" android:centerY="1.0"
                android:gradientRadius="60%p" android:startColor="#1F0307" android:endColor="#001F0307" />
        </shape>
    </item>
</layer-list>
