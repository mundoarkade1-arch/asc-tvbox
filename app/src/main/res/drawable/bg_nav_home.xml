<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <stroke android:width="5dp" android:color="#66FF2A3D" />
                    <corners android:radius="16dp" />
                </shape>
            </item>
            <item android:left="2.5dp" android:top="2.5dp" android:right="2.5dp" android:bottom="2.5dp">
                <shape android:shape="rectangle">
                    <gradient android:angle="315" android:startColor="#FF5A68" android:endColor="#D3091B" />
                    <stroke android:width="2dp" android:color="#FFFFFF" />
                    <corners android:radius="13dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#D3091B" />
            <stroke android:width="2dp" android:color="#FFFFFF" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <gradient android:angle="315" android:startColor="#FF5A68" android:endColor="#D3091B" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#33FF2A3D" />
            <stroke android:width="1dp" android:color="#66FF2A3D" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</selector>
